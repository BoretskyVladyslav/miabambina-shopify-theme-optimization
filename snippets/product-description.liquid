{% capture description %}
  {%- if product.empty? -%}
    {{ 'home_page.onboarding.product_description' | t }}
  {%- else -%}
    {{ product.description }}
  {%- endif -%}
{% endcapture %}
{%- assign description = description | strip -%}
{%- if description != blank -%}
  {%- if is_tab -%}
    {% assign title = 'products.product.description' | t %}
    {%- render 'tab', id: id, title: title, content: description -%}
  {%- else -%}
    <div class="rte">
      {{ description }}
    </div>
  {%- endif -%}
{%- endif -%}
