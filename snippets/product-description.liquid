{% capture description %}
  {%- if product.empty? -%}
    {{ 'home_page.onboarding.product_description' | t }}
  {%- else -%}
    {{ product.description }}
  {%- endif -%}
{% endcapture %}
{%- if is_tab -%}
  {% assign title = 'products.product.description' | t %}
  {%- capture description_html -%}
    <div data-product-description>{{ description }}</div>
  {%- endcapture -%}
  {%- render 'tab', id: id, title: title, content: description_html -%}
{%- else -%}
  <div class="rte" data-product-description>
    {{ description }}
  </div>
{%- endif -%}
<script src="{{ 'product-description-sanitize.js' | asset_url }}" defer="defer"></script>
