{% capture description %}
  {%- if product.empty? -%}
    {{ 'home_page.onboarding.product_description' | t }}
  {%- else -%}
    {{ product.description }}
  {%- endif -%}
{% endcapture %}
{%- liquid
  assign description = description | replace: '&ndash; Price $', 'PRICEAMT' | replace: '– Price $', 'PRICEAMT' | replace: '— Price $', 'PRICEAMT' | replace: ' - Price $', 'PRICEAMT' | replace: '- Price $', 'PRICEAMT' | replace: ' Price $', 'PRICEAMT' | replace: 'Price $', 'PRICEAMT'
-%}
{%- capture description -%}
  {%- assign desc_chunks = description | split: 'PRICEAMT' -%}
  {%- for chunk in desc_chunks -%}
    {%- if forloop.first -%}
      {{ chunk }}
    {%- else -%}
      {%- assign amt_bit = chunk | strip | split: '<' | first | split: '&' | first | split: ' ' | first -%}
      {%- assign amt_len = amt_bit | size -%}
      {%- if amt_len > 0 and amt_len <= 20 -%}
        {{ chunk | remove_first: amt_bit }}
      {%- else -%}
        {{ chunk }}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if is_tab -%}
  {% assign title = 'products.product.description' | t %}
  {%- render 'tab', id: id, title: title, content: description -%}
{%- else -%}
  <div class="rte">
    {{ description }}
  </div>
{%- endif -%}
