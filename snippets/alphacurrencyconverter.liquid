    function changeCartCurrency() {
        if(getCookie('user_currency') != null)
        {
          if(getCookie('user_currency') != getCookie('cart_currency'))
          {
            jQuery.post(window.Shopify.routes.root + 'cart/update.js', {
                              currency: getCookie('user_currency')
            });
          }
        }
    }
    
    
